<resources>
    <style name="Theme.Aurex" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/aurex_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Aurex.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/aurex_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Aurex</item>
    </style>
</resources>
